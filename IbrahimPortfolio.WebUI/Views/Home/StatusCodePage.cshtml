@{ Layout = null; var status = (int?)ViewData["StatusCode"] ?? 404; }
<!DOCTYPE html>
<html lang="tr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@status</title><link href="~/startbootstrap-sb-admin-gh-pages/css/styles.css" rel="stylesheet" /></head>
<body class="bg-light"><main class="container py-5"><h1>@status</h1><p>@(status == 404 ? "İstenen sayfa veya kayıt bulunamadı." : status == 403 ? "Bu sayfaya erişim yetkiniz yok." : "İstek tamamlanamadı. Lütfen tekrar deneyin.")</p><a href="/" class="btn btn-primary">Ana sayfa</a></main></body></html>
