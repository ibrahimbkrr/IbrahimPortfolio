@model List<IbrahimPortfolio.Dto.EducationDtos.ResultEducationDto>
<section class="resume-section" id="education"><div class="resume-section-content">
<h2 class="mb-5">Eğitim</h2>
@if (Model.Count == 0) { <p class="text-muted">Henüz eğitim bilgisi eklenmedi.</p> }
@foreach (var item in Model.OrderByDescending(x => x.StartDate)) {
<div class="d-flex flex-column flex-md-row justify-content-between mb-5">
<div class="flex-grow-1"><h3 class="mb-0">@item.SchoolName</h3><div class="subheading mb-3">@item.Degree</div><div>@item.Department</div><p>@item.Description</p></div>
<div class="flex-shrink-0"><span class="text-primary">@item.StartDate.ToString("MM.yyyy") - @(item.EndDate?.ToString("MM.yyyy") ?? "Devam Ediyor")</span></div>
</div> }
</div></section>
