@using IbrahimPortfolio.WebUI.Models
@model SidebarViewModel

<nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top"
     id="sideNav">

    <a class="navbar-brand js-scroll-trigger"
       href="#page-top">

        <span class="d-block d-lg-none">

            @if (Model.About != null)
            {
                @($"{Model.About.FirstName} {Model.About.LastName}")
            }

        </span>

        <span class="d-none d-lg-block">

            @{
                var imageUrl =
                !SafeUrlAttribute.IsSafe(Model.About?.ImageUrl, true)
                ? Url.Content("~/startbootstrap-resume-gh-pages/assets/img/profile.jpg")
                : Model.About?.ImageUrl;
            }

            <img class="img-fluid img-profile rounded-circle mx-auto mb-2"
                 src="@imageUrl"
                 alt="Profil Fotoğrafı" />

        </span>

    </a>

    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarResponsive"
            aria-controls="navbarResponsive"
            aria-expanded="false"
            aria-label="Menüyü Aç">

        <span class="navbar-toggler-icon"></span>

    </button>

    <div class="collapse navbar-collapse"
         id="navbarResponsive">

        <ul class="navbar-nav">

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#about">
                    Hakkımda
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#experience">
                    Deneyim
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#education">
                    Eğitim
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#skills">
                    Yetenekler
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#projects">
                    Projeler
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#certificates">
                    Sertifikalar
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link js-scroll-trigger" href="#contact">
                    İletişim
                </a>
            </li>

        </ul>

    </div>

</nav>
