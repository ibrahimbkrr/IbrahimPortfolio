@using IbrahimPortfolio.Dto.ExperienceDtos
@model List<ResultExperienceDto>

<section class="resume-section" id="experience">
    <div class="resume-section-content">

        <h2 class="mb-5">Deneyim</h2>

        @if (Model.Count == 0) { <p class="text-muted">Henüz kayıt bulunmuyor.</p> }
        @foreach (var item in Model)
        {
            <div class="d-flex flex-column flex-md-row justify-content-between mb-5">

                <div class="flex-grow-1">

                    <h3 class="mb-0">
                        @item.Position
                    </h3>

                    <div class="subheading mb-3">
                        @item.CompanyName
                    </div>

                    <p>
                        @item.Description
                    </p>

                </div>

                <div class="flex-shrink-0">

                    <span class="text-primary">
                        @item.StartDate.ToString("MMMM yyyy")
                        -
                        @(item.IsCurrent
                                            ? "Günümüz"
                                            : item.EndDate?.ToString("MMMM yyyy"))
                </span>

                </div>

            </div>
                }

    </div>
</section>
