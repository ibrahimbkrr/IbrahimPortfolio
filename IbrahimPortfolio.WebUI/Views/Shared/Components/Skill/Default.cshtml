@using IbrahimPortfolio.Dto.SkillDtos
@model List<ResultSkillDto>

<section class="resume-section" id="skills">
    <div class="resume-section-content">

        <h2 class="mb-5">Yetenekler</h2>

        <div class="subheading mb-3">
            Teknik Yetkinlikler
        </div>

        @if (Model.Count == 0) { <p class="text-muted">Henüz kayıt bulunmuyor.</p> }
        @foreach (var item in Model)
        {
            <div class="mb-4">

                <div class="d-flex justify-content-between">
                    <span>@item.Name</span>
                    <span>@(Math.Clamp(item.Level, 0, 100))%</span>
                </div>

                <div class="progress">
                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @(Math.Clamp(item.Level, 0, 100))%"
                         aria-valuenow="@(Math.Clamp(item.Level, 0, 100))"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>

            </div>
        }

    </div>
</section>
