<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>@ViewData["Title"] - IbrahimPortfolio Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css"
          rel="stylesheet" />

    <link href="~/startbootstrap-sb-admin-gh-pages/css/styles.css"
          rel="stylesheet" />

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
            crossorigin="anonymous"></script>
</head>

<body class="sb-nav-fixed">

    <!-- TOP NAVBAR -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">

        <a class="navbar-brand ps-3"
           asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">

            IbrahimPortfolio

        </a>

        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0"
                id="sidebarToggle"
                type="button">

            <i class="fas fa-bars"></i>

        </button>

        <div class="ms-auto d-flex align-items-center gap-2">

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               target="_blank" rel="noopener noreferrer"
               class="btn btn-outline-light btn-sm">

                <i class="fas fa-globe me-1"></i>
                Siteyi Gör

            </a>

            <form asp-area="Admin"
                  asp-controller="Login"
                  asp-action="Logout"
                  method="post"
                  class="m-0">

                <button type="submit"
                        class="btn btn-outline-danger btn-sm">

                    <i class="fas fa-right-from-bracket me-1"></i>
                    Çıkış

                </button>

            </form>

        </div>

    </nav>


    <div id="layoutSidenav">

        <!-- SIDEBAR -->
        <div id="layoutSidenav_nav">

            <nav class="sb-sidenav accordion sb-sidenav-dark"
                 id="sidenavAccordion">

                <div class="sb-sidenav-menu">

                    <div class="nav">

                        <div class="sb-sidenav-menu-heading">
                            Yönetim
                        </div>


                        <!-- Dashboard -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-tachometer-alt"></i>
                            </div>

                            Dashboard

                        </a>


                        <div class="sb-sidenav-menu-heading">
                            Portfolio
                        </div>


                        <!-- About -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="About"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-user"></i>
                            </div>

                            Hakkımda

                        </a>


                        <!-- Experience -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Experience"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-briefcase"></i>
                            </div>

                            Deneyimler

                        </a>


                        <!-- Education -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Education"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-graduation-cap"></i>
                            </div>

                            Eğitim

                        </a>


                        <!-- Skills -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Skill"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-code"></i>
                            </div>

                            Yetenekler

                        </a>


                        <!-- Projects -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Project"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-folder-open"></i>
                            </div>

                            Projeler

                        </a>


                        <!-- Certificates -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Certificate"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-certificate"></i>
                            </div>

                            Sertifikalar

                        </a>


                        <!-- Social Media -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="SocialMedia"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-share-alt"></i>
                            </div>

                            Sosyal Medya

                        </a>


                        <div class="sb-sidenav-menu-heading">
                            İletişim
                        </div>


                        <!-- Messages -->
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Message"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-envelope"></i>
                            </div>

                            Mesajlar

                        </a>

                    </div>

                </div>


                <div class="sb-sidenav-footer">

                    <div class="small">
                        Yönetim Paneli
                    </div>

                    IbrahimPortfolio

                </div>

            </nav>

        </div>


        <!-- CONTENT -->
        <div id="layoutSidenav_content">

            <main>

                <div class="container-fluid px-4">

                    <partial name="_ApiStatus" />
    @RenderBody()

                </div>

            </main>


            <!-- FOOTER -->
            <footer class="py-4 bg-light mt-auto">

                <div class="container-fluid px-4">

                    <div class="d-flex align-items-center justify-content-between small">

                        <div class="text-muted">

                            Copyright &copy;
                            IbrahimPortfolio @DateTime.Now.Year

                        </div>

                        <div>
                            Admin Panel
                        </div>

                    </div>

                </div>

            </footer>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>

    <script src="~/startbootstrap-sb-admin-gh-pages/js/scripts.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"
            crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

