@using IbrahimPortfolio.Dto.MessageDtos
@model ResultMessageDto

@{
    ViewData["Title"] = "Mesaj Detayı";
}

<h1 class="mt-4">Mesaj Detayı</h1>

<ol class="breadcrumb mb-4">

    <li class="breadcrumb-item">

        <a asp-area="Admin"
           asp-controller="Message"
           asp-action="Index">
            Mesajlar
        </a>

    </li>

    <li class="breadcrumb-item active">
        Mesaj Detayı
    </li>

</ol>

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <span>
            <i class="fas fa-envelope-open me-1"></i>
            @Model.Subject
        </span>

        <span class="badge bg-success">
            @(Model.IsRead ? "Okundu" : "Okunmadı")
        </span>

    </div>

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    Gönderen
                </label>

                <div>
                    @Model.Name
                </div>

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    E-posta
                </label>

                <div>

                    <a href="mailto:@Model.Email">
                        @Model.Email
                    </a>

                </div>

            </div>

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">
                Konu
            </label>

            <div>
                @Model.Subject
            </div>

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">
                Tarih
            </label>

            <div>
                @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </div>

        </div>

        <hr />

        <div class="mb-4">

            <label class="form-label fw-bold">
                Mesaj
            </label>

            <div class="border rounded p-3 bg-light"
                 style="white-space: pre-wrap;">
                @Model.MessageContent
            </div>

        </div>

        <div class="d-flex justify-content-between">

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>
                Mesajlara Dön

            </a>

            <form method="post" class="d-inline" asp-area="Admin"
               asp-controller="Message"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?')"><button type="submit" class="btn btn-danger">

                <i class="fas fa-trash me-1"></i>
                Mesajı Sil

            </button></form>

        </div>

    </div>

</div>@if (!Model.IsRead) { <form method="post" asp-action="Open" asp-route-id="@Model.Id"><button class="btn btn-success" type="submit">Okundu işaretle</button></form> }

