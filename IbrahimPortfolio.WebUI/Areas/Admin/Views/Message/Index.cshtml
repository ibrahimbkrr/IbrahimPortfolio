@using IbrahimPortfolio.Dto.MessageDtos
@model List<ResultMessageDto>

@{
    ViewData["Title"] = "Mesajlar";
}

<h1 class="mt-4">Mesajlar</h1>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item">Admin</li>
    <li class="breadcrumb-item active">Mesajlar</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card mb-4">

    <div class="card-header">

        <i class="fas fa-envelope me-1"></i>
        Gelen Mesajlar

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Gönderen</th>
                        <th>E-posta</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th style="width: 210px;">İşlem</th>
                    </tr>

                </thead>

                <tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center">Henüz kayıt bulunmuyor.</td></tr> }

                    @foreach (var item in Model.OrderByDescending(x => x.CreatedAt))
                    {
                        <tr class="@(!item.IsRead ? "table-warning" : "")">

                            <td>

                                @if (!item.IsRead)
                                {
                                    <strong>@item.Name</strong>
                                }
                                else
                                {
                                    @item.Name
                                }

                            </td>

                            <td>@item.Email</td>

                            <td>@item.Subject</td>

                            <td>
                                @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>

                                @if (item.IsRead)
                                {
                                    <span class="badge bg-success">
                                        Okundu
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Yeni
                                    </span>
                                }

                            </td>

                            <td>

                                <form method="post" class="d-inline"  asp-area="Admin"
                                   asp-controller="Message"
                                   asp-action="Open"
                                   asp-route-id="@item.Id"
                                   ><button type="submit" class="btn btn-primary btn-sm" aria-label="Görüntüle">

                                    <i class="fas fa-eye"></i>

                                </button></form>

                                @if (!item.IsRead)
                                {
                                    <form method="post" class="d-inline" asp-area="Admin"
                                       asp-controller="Message"
                                       asp-action="MarkAsRead"
                                       asp-route-id="@item.Id"><button type="submit" class="btn btn-success btn-sm">

                                        <i class="fas fa-check"></i>

                                    </button></form>
                                }

                                <form method="post" class="d-inline" asp-area="Admin"
                                   asp-controller="Message"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?')"><button type="submit" class="btn btn-danger btn-sm">

                                    <i class="fas fa-trash"></i>

                                </button></form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

