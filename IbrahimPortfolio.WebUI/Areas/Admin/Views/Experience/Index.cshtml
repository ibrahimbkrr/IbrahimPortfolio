@using IbrahimPortfolio.Dto.ExperienceDtos
@model List<ResultExperienceDto>

@{
    ViewData["Title"] = "Deneyimler";
}

<h1 class="mt-4">Deneyimler</h1>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item">Admin</li>
    <li class="breadcrumb-item active">Deneyimler</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <span>
            <i class="fas fa-briefcase me-1"></i>
            Deneyim Listesi
        </span>

        <a asp-area="Admin"
           asp-controller="Experience"
           asp-action="Create"
           class="btn btn-primary btn-sm">

            <i class="fas fa-plus me-1"></i>
            Yeni Deneyim

        </a>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Şirket</th>
                        <th>Pozisyon</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>Durum</th>
                        <th style="width:180px;">İşlem</th>
                    </tr>
                </thead>

                <tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center">Henüz kayıt bulunmuyor.</td></tr> }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.CompanyName</td>

                            <td>@item.Position</td>

                            <td>@item.StartDate.ToString("dd.MM.yyyy")</td>

                            <td>
                                @(item.EndDate.HasValue
                                                            ? item.EndDate.Value.ToString("dd.MM.yyyy")
                                                            : "-")
                        </td>

                            <td>
                            @if (item.IsCurrent)
                                {
                                    <span class="badge bg-success">
                                        Devam Ediyor
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Tamamlandı
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="Experience"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-pen"></i>

                                </a>

                                <form method="post" class="d-inline" asp-area="Admin"
                                   asp-controller="Experience"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   onsubmit="return confirm('Bu deneyimi silmek istediğinize emin misiniz?')"><button type="submit" class="btn btn-danger btn-sm">

                                    <i class="fas fa-trash"></i>

                                </button></form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
