@using IbrahimPortfolio.Dto.SkillDtos
@model UpdateSkillDto

@{
    ViewData["Title"] = "Yetenek Güncelle";
}

<h1 class="mt-4">Yetenek Güncelle</h1>

<ol class="breadcrumb mb-4">

    <li class="breadcrumb-item">

        <a asp-area="Admin"
           asp-controller="Skill"
           asp-action="Index">
            Yetenekler
        </a>

    </li>

    <li class="breadcrumb-item active">
        Güncelle
    </li>

</ol>

<div class="card mb-4">

    <div class="card-header">

        <i class="fas fa-pen me-1"></i>
        Yetenek Bilgisini Düzenle

    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Skill"
              asp-action="Update"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>

            <div class="mb-3">

                <label asp-for="Name"
                       class="form-label">
                    Yetenek Adı
                </label>

                <input asp-for="Name"
                       class="form-control" />
<span asp-validation-for="Name" class="text-danger"></span>

            </div>

            <div class="mb-3">

                <label asp-for="Level"
                       class="form-label">
                    Seviye
                </label>

                <input asp-for="Level"
                       type="number"
                       min="0"
                       max="100"
                       class="form-control" />
<span asp-validation-for="Level" class="text-danger"></span>

                <div class="form-text">
                    0 ile 100 arasında bir değer gir.
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <a asp-area="Admin"
                   asp-controller="Skill"
                   asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Geri Dön

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    Güncelle

                </button>

            </div>

        </form>

    </div>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

