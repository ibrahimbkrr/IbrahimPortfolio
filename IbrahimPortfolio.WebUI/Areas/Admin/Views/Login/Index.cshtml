@model IbrahimPortfolio.WebUI.Models.AdminLoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>Admin Giriş - IbrahimPortfolio</title>

    <link href="~/startbootstrap-sb-admin-gh-pages/css/styles.css"
          rel="stylesheet" />

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
            crossorigin="anonymous">
    </script>

</head>


<body class="bg-primary">

    <div id="layoutAuthentication">

        <div id="layoutAuthentication_content">

            <main>

                <div class="container">

                    <div class="row justify-content-center">

                        <div class="col-lg-5">

                            <div class="card shadow-lg border-0 rounded-lg mt-5">

                                <div class="card-header">

                                    <h3 class="text-center font-weight-light my-4">

                                        <i class="fas fa-user-shield me-2"></i>

                                        Yönetim Paneli

                                    </h3>

                                </div>


                                <div class="card-body">

                                    <div class="text-center mb-4">

                                        <h5>IbrahimPortfolio</h5>

                                        <p class="text-muted">
                                            Devam etmek için yönetici hesabınızla giriş yapın.
                                        </p>

                                    </div>


                                    <form asp-area="Admin"
                                          asp-controller="Login"
                                          asp-action="Index"
                                          method="post">

                                        <div asp-validation-summary="ModelOnly"
                                             class="text-danger mb-3">
                                        </div>


                                        <div class="form-floating mb-3">

                                            <input asp-for="Username"
                                                   class="form-control"
                                                   placeholder="Kullanıcı adı"
                                                   autocomplete="username" />

                                            <label asp-for="Username">
                                                Kullanıcı Adı
                                            </label>

                                            <span asp-validation-for="Username"
                                                  class="text-danger">
                                            </span>

                                        </div>


                                        <div class="form-floating mb-3">

                                            <input asp-for="Password"
                                                   class="form-control"
                                                   placeholder="Şifre"
                                                   autocomplete="current-password" />

                                            <label asp-for="Password">
                                                Şifre
                                            </label>

                                            <span asp-validation-for="Password"
                                                  class="text-danger">
                                            </span>

                                        </div>


                                        <div class="form-check mb-3">

                                            <input asp-for="RememberMe"
                                                   class="form-check-input" />

                                            <label asp-for="RememberMe"
                                                   class="form-check-label">

                                                Beni hatırla

                                            </label>

                                        </div>


                                        <div class="d-grid">

                                            <button type="submit"
                                                    class="btn btn-primary">

                                                <i class="fas fa-right-to-bracket me-1"></i>

                                                Giriş Yap

                                            </button>

                                        </div>

                                    </form>

                                </div>


                                <div class="card-footer text-center py-3">

                                    <a asp-area=""
                                       asp-controller="Home"
                                       asp-action="Index"
                                       class="small text-decoration-none">

                                        <i class="fas fa-arrow-left me-1"></i>

                                        Portfolyoya Dön

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </main>

        </div>


        <div id="layoutAuthentication_footer">

            <footer class="py-4 bg-light mt-auto">

                <div class="container-fluid px-4">

                    <div class="text-center small">

                        Copyright © IbrahimPortfolio 2026

                    </div>

                </div>

            </footer>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous">
    </script>

    <script src="~/startbootstrap-sb-admin-gh-pages/js/scripts.js">
    </script>

<partial name="_ValidationScriptsPartial" />
</body>

</html>
