@using IbrahimPortfolio.Dto.AboutDtos
@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Hakkımda Yönetimi";
}

<h1 class="mt-4">Hakkımda Yönetimi</h1>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item">Admin</li>
    <li class="breadcrumb-item active">Hakkımda</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>

    </div>
}

<div class="card mb-4">

    <div class="card-header">
        <i class="fas fa-user me-1"></i>
        Hakkımda Bilgileri
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Unvan</th>
                        <th>E-posta</th>
                        <th style="width: 120px;">İşlem</th>
                    </tr>
                </thead>

                <tbody>
@if (Model.Count == 0) { <tr><td colspan="5" class="text-muted text-center">Henüz kayıt bulunmuyor.</td></tr> }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.FirstName</td>

                            <td>@item.LastName</td>

                            <td>@item.Title</td>

                            <td>@item.Email</td>

                            <td>
                                <a asp-area="Admin"
                                   asp-controller="About"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-pen me-1"></i>
                                    Güncelle
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
