@using IbrahimPortfolio.Dto.EducationDtos
@model CreateEducationDto

@{
    ViewData["Title"] = "Yeni Eğitim";
}

<h1 class="mt-4">Yeni Eğitim</h1>

<ol class="breadcrumb mb-4">

    <li class="breadcrumb-item">
        <a asp-area="Admin"
           asp-controller="Education"
           asp-action="Index">
            Eğitim
        </a>
    </li>

    <li class="breadcrumb-item active">
        Yeni Eğitim
    </li>

</ol>

<div class="card mb-4">

    <div class="card-header">
        <i class="fas fa-plus me-1"></i>
        Eğitim Bilgisi Ekle
    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Education"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="SchoolName"
                           class="form-label">
                        Okul Adı
                    </label>

                    <input asp-for="SchoolName"
                           class="form-control" />
<span asp-validation-for="SchoolName" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Department"
                           class="form-label">
                        Bölüm
                    </label>

                    <input asp-for="Department"
                           class="form-control" />
<span asp-validation-for="Department" class="text-danger"></span>

                </div>

            </div>

            <div class="mb-3">

                <label asp-for="Degree"
                       class="form-label">
                    Derece
                </label>

                <input asp-for="Degree"
                       class="form-control"
                       placeholder="Örn: Lisans" />
<span asp-validation-for="Degree" class="text-danger"></span>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="StartDate"
                           class="form-label">
                        Başlangıç Tarihi
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />
<span asp-validation-for="StartDate" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="EndDate"
                           class="form-label">
                        Bitiş Tarihi
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />
<span asp-validation-for="EndDate" class="text-danger"></span>

                </div>

            </div>

            <div class="mb-3">

                <label asp-for="Description"
                       class="form-label">
                    Açıklama
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"></textarea>
<span asp-validation-for="Description" class="text-danger"></span>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <a asp-area="Admin"
                   asp-controller="Education"
                   asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Geri Dön

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    Kaydet

                </button>

            </div>

        </form>

    </div>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

