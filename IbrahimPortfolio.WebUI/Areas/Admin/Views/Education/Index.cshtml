@using IbrahimPortfolio.Dto.EducationDtos
@model List<ResultEducationDto>

@{
    ViewData["Title"] = "Eğitim";
}

<h1 class="mt-4">Eğitim</h1>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item">Admin</li>
    <li class="breadcrumb-item active">Eğitim</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <span>
            <i class="fas fa-graduation-cap me-1"></i>
            Eğitim Bilgileri
        </span>

        <a asp-area="Admin"
           asp-controller="Education"
           asp-action="Create"
           class="btn btn-primary btn-sm">

            <i class="fas fa-plus me-1"></i>
            Yeni Eğitim

        </a>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Okul</th>
                        <th>Bölüm</th>
                        <th>Derece</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th style="width: 180px;">İşlem</th>
                    </tr>
                </thead>

                <tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center">Henüz kayıt bulunmuyor.</td></tr> }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.SchoolName</td>

                            <td>@item.Department</td>

                            <td>@item.Degree</td>

                            <td>
                                @item.StartDate.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                @(item.EndDate.HasValue
                                                            ? item.EndDate.Value.ToString("dd.MM.yyyy")
                                                            : "Devam Ediyor")
                        </td>

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="Education"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-pen"></i>

                                </a>

                                <form method="post" class="d-inline" asp-area="Admin"
                                   asp-controller="Education"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   onsubmit="return confirm('Bu eğitim bilgisini silmek istediğinize emin misiniz?')"><button type="submit" class="btn btn-danger btn-sm">

                                    <i class="fas fa-trash"></i>

                                </button></form>

                            </td>

                        </tr>
                                        }

                </tbody>

            </table>

        </div>

    </div>

</div>
