@using IbrahimPortfolio.Dto.SocialMediaDtos
@model UpdateSocialMediaDto

@{
    ViewData["Title"] = "Sosyal Medya Güncelle";
}

<h1 class="mt-4">Sosyal Medya Güncelle</h1>

<div class="card mb-4">

    <div class="card-header">
        <i class="fas fa-pen me-1"></i>
        Hesap Bilgilerini Düzenle
    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="SocialMedia"
              asp-action="Update"
              method="post"><div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input asp-for="Id" type="hidden" />

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Name" class="form-label">
                        Platform
                    </label>

                    <input asp-for="Name"
                           class="form-control" />
<span asp-validation-for="Name" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="DisplayOrder" class="form-label">
                        Sıra
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control" />
<span asp-validation-for="DisplayOrder" class="text-danger"></span>

                </div>

            </div>

            <div class="mb-3">

                <label asp-for="Url" class="form-label">
                    URL
                </label>

                <input asp-for="Url"
                       class="form-control" />
<span asp-validation-for="Url" class="text-danger"></span>

            </div>

            <div class="mb-3">

                <label asp-for="Icon" class="form-label">
                    Icon
                </label>

                <input asp-for="Icon"
                       class="form-control" />
<span asp-validation-for="Icon" class="text-danger"></span>

            </div>

            <div class="form-check mb-4">

                <input asp-for="IsActive"
                       class="form-check-input" />
<span asp-validation-for="IsActive" class="text-danger"></span>

                <label asp-for="IsActive"
                       class="form-check-label">
                    Aktif
                </label>

            </div>

            <div class="d-flex justify-content-between">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Geri Dön
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Güncelle
                </button>

            </div>

        </form>

    </div>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

