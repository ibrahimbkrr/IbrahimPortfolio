@using IbrahimPortfolio.Dto.CertificateDtos
@model List<ResultCertificateDto>

@{
    ViewData["Title"] = "Sertifikalar";
}

<h1 class="mt-4">Sertifikalar</h1>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item">Admin</li>
    <li class="breadcrumb-item active">Sertifikalar</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <span>
            <i class="fas fa-certificate me-1"></i>
            Sertifika Listesi
        </span>

        <a asp-area="Admin"
           asp-controller="Certificate"
           asp-action="Create"
           class="btn btn-primary btn-sm">

            <i class="fas fa-plus me-1"></i>
            Yeni Sertifika
        </a>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Sertifika</th>
                        <th>Veren Kurum</th>
                        <th>Veriliş Tarihi</th>
                        <th>Son Geçerlilik</th>
                        <th>Belge</th>
                        <th style="width: 180px;">İşlem</th>
                    </tr>
                </thead>

                <tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="text-muted text-center">Henüz kayıt bulunmuyor.</td></tr> }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.Name</strong>
                            </td>

                            <td>@item.Issuer</td>

                            <td>
                                @item.IssueDate.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                @(item.ExpirationDate.HasValue
                                                            ? item.ExpirationDate.Value.ToString("dd.MM.yyyy")
                                                            : "-")
                        </td>

                            <td>

                            @if (SafeUrlAttribute.IsSafe(item.CredentialUrl))
                                {
                                    <a href="@item.CredentialUrl"
                                       target="_blank" rel="noopener noreferrer"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="fas fa-external-link-alt me-1"></i>
                                        Görüntüle
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </td>

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="Certificate"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-pen"></i>
                                </a>

                                <form method="post" class="d-inline" asp-area="Admin"
                                   asp-controller="Certificate"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   onsubmit="return confirm('Bu sertifikayı silmek istediğinize emin misiniz?')"><button type="submit" class="btn btn-danger btn-sm">

                                    <i class="fas fa-trash"></i>
                                </button></form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
