@using IbrahimPortfolio.Dto.ProjectDtos
@model List<ResultProjectDto>

@{
    ViewData["Title"] = "Projeler";
}

<h1 class="mt-4">Projeler</h1>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item">Admin</li>
    <li class="breadcrumb-item active">Projeler</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <span>
            <i class="fas fa-folder-open me-1"></i>
            Proje Listesi
        </span>

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="Create"
           class="btn btn-primary btn-sm">

            <i class="fas fa-plus me-1"></i>
            Yeni Proje
        </a>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Proje</th>
                        <th>Teknolojiler</th>
                        <th>GitHub</th>
                        <th>Canlı</th>
                        <th style="width:180px;">İşlem</th>
                    </tr>
                </thead>

                <tbody>
@if (Model.Count == 0) { <tr><td colspan="5" class="text-muted text-center">Henüz kayıt bulunmuyor.</td></tr> }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.Name</strong>
                            </td>

                            <td>
                                @item.Technologies
                            </td>

                            <td>
                                @if (SafeUrlAttribute.IsSafe(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl"
                                       target="_blank" rel="noopener noreferrer"
                                       class="btn btn-dark btn-sm">

                                        <i class="fab fa-github"></i>
                                        GitHub
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @if (SafeUrlAttribute.IsSafe(item.LiveUrl))
                                {
                                    <a href="@item.LiveUrl"
                                       target="_blank" rel="noopener noreferrer"
                                       class="btn btn-success btn-sm">

                                        <i class="fas fa-external-link-alt"></i>
                                        Aç
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>

                                <a asp-area="Admin"
                                   asp-controller="Project"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-pen"></i>
                                </a>

                                <form method="post" class="d-inline" asp-area="Admin"
                                   asp-controller="Project"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz?')"><button type="submit" class="btn btn-danger btn-sm">

                                    <i class="fas fa-trash"></i>
                                </button></form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
